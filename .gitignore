# lab/: only folders, .py and .ipynb files
lab/**
!lab/**/
!lab/**/*.py
!lab/**/*.ipynb

# simulation/ (includes rsoft_lib): only folders, .py and .ipynb files
simulation/**
!simulation/**/
!simulation/**/*.py
!simulation/**/*.ipynb

# Exclusions (must stay below the whitelist rules)
lab/Data/
lab/ControlCode/DataAcquisitionNotebooks/obsolete/
lab/ControlCode/Manuals/
lab/ControlCode/VendorResources/
**/__pycache__/
**/.ipynb_checkpoints/
